# === БЛОК НЕЙРОСЕТИ CVAE И ЗАГРУЗКИ ВЕСОВ ===
import torch
import torch.nn as nn
from scipy.ndimage import gaussian_filter1d

class GeologicalCVAE(nn.Module):
    def __init__(self, input_dim, latent_dim=4):
        super(GeologicalCVAE, self).__init__()
        self.input_dim = input_dim
        self.latent_dim = latent_dim
        
        self.decoder = nn.Sequential(
            nn.Linear(latent_dim, 32),
            nn.LeakyReLU(0.2),
            nn.Linear(32, 64),
            nn.LeakyReLU(0.2),
            nn.Linear(64, input_dim * 2),
            nn.Tanh()
        )

    def decode(self, z):
        recon = self.decoder(z)
        return recon.view(-1, 2, self.input_dim)

@st.cache_resource
def load_cvae(weights_path="cvae_weights.pt"):
    try:
        ckpt = torch.load(weights_path, map_location=torch.device('cpu'), weights_only=False)
        net = GeologicalCVAE(input_dim=ckpt['input_dim'], latent_dim=4)
        net.load_state_dict(ckpt['model_state'], strict=False)
        net.eval()
        return net, ckpt
    except Exception:
        return None, None
# ============================================

# === НАЧАЛО: МАТЕМАТИЧЕСКИЕ ФУНКЦИИ ===
def resample_curve(curve_series, target_length):
    x_old = np.linspace(0, 1, num=len(curve_series))
    x_new = np.linspace(0, 1, num=target_length)
    f = interp1d(x_old, curve_series, kind='linear', fill_value="extrapolate")
    return pd.Series(f(x_new))

def resample_curve_on_depth(depth_src, curve_src, depth_target):
    mask = (~np.isnan(curve_src)) & (np.array(curve_src, dtype=float) > -900)
    d_clean = np.array(depth_src, dtype=float)[mask]
    c_clean = np.array(curve_src, dtype=float)[mask]
    if len(d_clean) < 2:
        return np.full_like(depth_target, np.nan)
    f = interp1d(d_clean, c_clean, kind='linear', bounds_error=False, fill_value="extrapolate")
    return f(depth_target)

def morph_wells(well_a, well_b, weight):
    max_len = max(len(well_a), len(well_b))
    a_resamp = resample_curve(well_a, max_len) if len(well_a) < max_len else well_a.reset_index(drop=True)
    b_resamp = resample_curve(well_b, max_len) if len(well_b) < max_len else well_b.reset_index(drop=True)
    synthetic_base = a_resamp * (1 - weight) + b_resamp * weight
    return synthetic_base

def compute_idw_weights(wells, target_x, target_y):
    distances = []
    for w in wells:
        d = np.sqrt((w['x'] - target_x)**2 + (w['y'] - target_y)**2)
        distances.append(max(d, 0.001))
    inv_d = [1.0 / (d**1.5) for d in distances]
    total_inv = sum(inv_d)
    return [w / total_inv for w in inv_d]

def find_curve_idw_column(df_columns, targets):
    for col in df_columns:
        c_clean = str(col).strip().upper()
        if c_clean in targets:
            return col
    for col in df_columns:
        c_clean = str(col).strip().upper()
        if any(t in c_clean for t in targets):
            return col
    return None

def extract_idw_well_info(uploaded_file, default_idx=0):
    raw_bytes = uploaded_file.getvalue()
    text = None
    for enc in ['utf-8', 'windows-1251', 'cp1251', 'latin-1']:
        try:
            text = raw_bytes.decode(enc)
            break
        except UnicodeDecodeError:
            continue
    if text is None:
        raise ValueError(f"Не удалось декодировать файл {uploaded_file.name}")

    las = lasio.read(io.StringIO(text))
    df = las.df().reset_index()
    if df is None or len(df) == 0:
        raise ValueError(f"Файл {uploaded_file.name} не содержит каротажных данных")

    depth_col = None
    targets_depth = ['DEPT', 'DEPTH', 'GLUB', 'ГЛУБИНА', 'ГЛУБ']
    for t in targets_depth:
        for c in df.columns:
            if t in str(c).upper():
                depth_col = c
                break
        if depth_col: break
    if depth_col is None:
        depth_col = df.columns[0]

    x, y = 0.0, 0.0
    for key in ['X', 'X_COORD', 'EASTING', 'XCOORD', 'X_LOC']:
        if key in las.well:
            try:
                x = float(str(las.well[key].value).replace(',', '.'))
                break
            except Exception: pass
    for key in ['Y', 'Y_COORD', 'NORTHING', 'YCOORD', 'Y_LOC']:
        if key in las.well:
            try:
                y = float(str(las.well[key].value).replace(',', '.'))
                break
            except Exception: pass
    if x == 0.0 and y == 0.0:
        x = float((default_idx + 1) * 450.0)
        y = float(200.0 + (default_idx % 2) * 350.0)

    ps_targets = ['PS', 'SP', 'SPC', 'ПС', 'SP_1', 'CPS', 'SP_ED']
    gk_targets = ['GK', 'GR', 'GAMMA', 'ГК', 'GR_1', 'CGR', 'GAM', 'GR_ED']
    res_targets = ['RES', 'BK', 'RT', 'БК']
    cond_targets = ['COND', 'IK', 'ИК']
    nphi_targets = ['NPHI', 'NKT', 'NK', 'НКТ']
    gmz_targets = ['GMZ', 'PMZ', 'MKZ', 'МКЗ']

    curve_map = {
        'GK': find_curve_idw_column(df.columns, gk_targets),
        'SP': find_curve_idw_column(df.columns, ps_targets),
        'RES': find_curve_idw_column(df.columns, res_targets),
        'COND': find_curve_idw_column(df.columns, cond_targets),
        'NPHI': find_curve_idw_column(df.columns, nphi_targets),
        'GMZ': find_curve_idw_column(df.columns, gmz_targets),
    }
    return {
        'name': uploaded_file.name,
        'las': las,
        'df': df,
        'depth_col': depth_col,
        'x': x,
        'y': y,
        'curves': curve_map,
        'all_curves': list(df.columns)
    }
# === КОНЕЦ: МАТЕМАТИЧЕСКИЕ ФУНКЦИИ ===

# === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (ГЛОБАЛЬНАЯ ОБЛАСТЬ) ===

def decode_file_content(bytes_data):
    for encoding in ['utf-8', 'cp1251', 'latin-1']:
        try: return bytes_data.decode(encoding)
        except UnicodeDecodeError: continue
    raise UnicodeDecodeError("Ошибка декодирования")

def find_depth_column(cols):
    targets = ['DEPT', 'DEPTH', 'GLUB', 'ГЛУБИНА', 'ГЛУБ']
    for t in targets:
        for c in cols:
            if t in c.upper():
                return c
    return cols[0]

def find_best_mnemonic(targets, options):
    for target in targets:
        for i, opt in enumerate(options):
            if target.upper() == opt.upper() or opt.upper().startswith(target.upper()):
                return i + 1
    return 0

def calculate_cv_stats(series):
    if series.empty or series.isna().all(): return 0, 0, 0
    mu = float(series.mean())
    sigma = float(series.std())
    cv = sigma / abs(mu) if mu != 0 else 0
    return mu, sigma, cv

def calculate_hellinger_distance(p, q, bins=50):
    p = p[~np.isnan(p)]
    q = q[~np.isnan(q)]
    if len(p) == 0 or len(q) == 0: return 1.0
    min_val = min(np.min(p), np.min(q))
    max_val = max(np.max(p), np.max(q))
    hist_p, _ = np.histogram(p, bins=bins, range=(min_val, max_val), density=True)
    hist_q, _ = np.histogram(q, bins=bins, range=(min_val, max_val), density=True)
    hist_p = hist_p / np.sum(hist_p) if np.sum(hist_p) > 0 else hist_p
    hist_q = hist_q / np.sum(hist_q) if np.sum(hist_q) > 0 else hist_q
    h_dist = np.sqrt(np.sum((np.sqrt(hist_p) - np.sqrt(hist_q)) ** 2)) / np.sqrt(2)
    return float(h_dist)

def generate_cv_synthetic(original_series, cv_multiplier, curve_type=None, saturation="Вода (База)", apply_fluid_effect=False, add_artifacts=False, noise_scale=1.0):
    mu, sigma, cv = calculate_cv_stats(original_series)
    window = max(5, len(original_series)//10)
    trend = original_series.rolling(window=window, center=True, min_periods=1).mean()
    new_sigma = cv * cv_multiplier * abs(mu) * noise_scale
    noise = np.random.normal(0, new_sigma, size=len(original_series))
    
    if curve_type in ['SP', 'PS']:
        noise = noise * 0.3
    
    synth = trend + noise
    
    if curve_type in ['SP', 'PS']:
        synth = pd.Series(synth).rolling(window=3, center=True, min_periods=1).mean().values
        
    if apply_fluid_effect:
        if saturation == "Нефть":
            if curve_type in ['RES', 'BK', 'GMZ', 'PMZ']:
                synth = synth * 4.0
            elif curve_type in ['COND', 'IK']:
                synth = synth / 4.0
        elif saturation == "Газ":
            if curve_type in ['RES', 'BK', 'GMZ', 'PMZ']:
                synth = synth * 10.0
            elif curve_type in ['COND', 'IK']:
                synth = synth / 10.0
            elif curve_type in ['NPHI', 'NKT', 'NK']:
                synth = np.clip(synth - 0.08, -0.02, 1.0)
                
    if add_artifacts:
        synth_arr = np.array(synth, dtype=float)
        n_points = len(synth_arr)
        missing_mask = np.random.rand(n_points) < 0.05
        synth_arr[missing_mask] = np.nan
        spike_mask = (np.random.rand(n_points) < 0.01) & (~np.isnan(synth_arr))
        spikes = np.random.choice([1, -1], size=np.sum(spike_mask)) * 3 * sigma
        synth_arr[spike_mask] = synth_arr[spike_mask] + spikes
        synth = synth_arr
        
    return synth

def generate_dummy_data():
    depth = np.arange(2000, 2500, 0.1)
    gk = 50 + 30 * np.sin(depth * 0.05) + np.random.normal(0, 5, len(depth))
    sp = -20 + 40 * np.cos(depth * 0.03) + np.random.normal(0, 3, len(depth))
    res = 10 ** (np.sin(depth * 0.02) + 1 + np.random.normal(0, 0.1, len(depth)))
    dt = 200 + 50 * np.sin(depth * 0.04) + np.random.normal(0, 10, len(depth))
    return pd.DataFrame({'DEPTH': depth, 'GK': gk, 'SP': sp, 'RES': res, 'DT': dt})

def get_las_binary(original_las, synthetic_df, depth_col, well_x=None, well_y=None, well_name="Synthetic_Well_01"):
    if original_las is not None:
        new_las = copy.deepcopy(original_las)
        if 'WELL' in new_las.well: new_las.well.WELL.value = well_name
        if 'COMP' in new_las.well: new_las.well.COMP.value = "Edu_Project_University"
        if 'FLD' in new_las.well: new_las.well.FLD.value = "Virtual_Field"
        if 'LOC' in new_las.well: new_las.well.LOC.value = "Classroom"
        if 'DATE' in new_las.well: new_las.well.DATE.value = "2026-01-01"
        if well_x is not None and 'X' in new_las.well: new_las.well.X.value = f"{well_x}"
        if well_y is not None and 'Y' in new_las.well: new_las.well.Y.value = f"{well_y}"
    else:
        new_las = lasio.LASFile()
        new_las.well.WELL = well_name
        new_las.well.COMP = "Edu_Project_University"
        new_las.well.FLD = "Virtual_Field"
        new_las.well.LOC = "Classroom"
        new_las.well.DATE = "2026-01-01"
        if well_x is not None:
            try: new_las.well['X'] = lasio.HeaderItem('X', value=str(well_x), descr='X Coordinate')
            except Exception: pass
        if well_y is not None:
            try: new_las.well['Y'] = lasio.HeaderItem('Y', value=str(well_y), descr='Y Coordinate')
            except Exception: pass

    new_las.curves.clear()
    new_las.insert_curve(0, depth_col, synthetic_df[depth_col].values, unit='m', descr='DEPTH')
    for col in synthetic_df.columns:
        if col != depth_col:
            descr = ''
            unit = ''
            if original_las is not None and col in original_las.keys():
                descr = original_las.curves[col].descr
                unit = original_las.curves[col].unit
            new_las.append_curve(col, synthetic_df[col].values, unit=unit, descr=descr)

    text_buf = io.StringIO()
    try:
        new_las.write(text_buf, version=2.0)
    except TypeError:
        new_las.write(text_buf)
    string_data = text_buf.getvalue()
    return string_data.encode('utf-8')

def plot_log_comparison(df_orig, df_synth, depth_col, curves_map, mode, saturation="Вода (База)", apply_fluid_effect=False, plot_width=10, plot_height=8, show_grid=True):
    plt.style.use('dark_background')
    fig_bg = '#1F262F'
    ax_bg = '#161B22'
    text_color = '#94A3B8'
    spine_color = '#2D333B'
    
    if mode == "Глинистость (ГК)":
        fig, axes = plt.subplots(1, 2, figsize=(plot_width, plot_height), sharey=True)
        c_name = curves_map.get('GK')
        color = '#3B82F6'
        for i, (df, label) in enumerate([(df_orig, 'ИСХОДНЫЕ ДАННЫЕ'), (df_synth, 'СИНТЕТИКА (РЕЗУЛЬТАТ)')]):
            if c_name and c_name in df.columns:
                axes[i].plot(df[c_name], df[depth_col], color=color, lw=1.5)
                axes[i].fill_betweenx(df[depth_col], df[c_name].min(), df[c_name], color=color, alpha=0.15)
            axes[i].set_title(f"{label}", fontsize=11, fontweight='bold', color=text_color)
            axes[i].set_xlabel("Гамма-каротаж (мкР/ч)", fontsize=9, fontweight='bold', color=text_color)
            axes[i].set_xlim(0, 150)
            
    elif mode == "Потенциал (ПС)":
        fig, axes = plt.subplots(1, 2, figsize=(plot_width, plot_height), sharey=True)
        c_name = curves_map.get('SP')
        color = '#8B5CF6'
        for i, (df, label) in enumerate([(df_orig, 'ИСХОДНЫЕ ДАННЫЕ'), (df_synth, 'СИНТЕТИКА (РЕЗУЛЬТАТ)')]):
            if c_name and c_name in df.columns:
                axes[i].plot(df[c_name], df[depth_col], color=color, lw=1.5)
                axes[i].fill_betweenx(df[depth_col], df[c_name].min(), df[c_name], color=color, alpha=0.15)
            axes[i].set_title(f"{label}", fontsize=11, fontweight='bold', color=text_color)
            axes[i].set_xlabel("ПС (мВ)", fontsize=9, fontweight='bold', color=text_color)
            
    elif mode == "Сопротивление (БК)":
        fig, axes = plt.subplots(1, 2, figsize=(plot_width, plot_height), sharey=True)
        res_name = curves_map.get('RES')
        if res_name and res_name in df_synth.columns and res_name in df_orig.columns:
            axes[0].semilogx(df_orig[res_name], df_orig[depth_col], color=text_color, lw=1.5, label='Исходное (Вода)')
            axes[0].set_title("ИСХОДНЫЕ ДАННЫЕ", fontsize=11, fontweight='bold', color=text_color)
            axes[0].set_xlabel("Уд. Сопротивление (Ом·м)", fontsize=9, fontweight='bold', color=text_color)
            axes[0].legend(fontsize=8, loc='upper right')
            
            axes[1].semilogx(df_orig[res_name], df_orig[depth_col], color=text_color, lw=1, alpha=0.6, label='Исходное (Ref)')
            axes[1].semilogx(df_synth[res_name], df_synth[depth_col], color='#EF4444', lw=1.8, label='Синтетика (Результат)')
            if apply_fluid_effect and saturation != "Вода (База)":
                axes[1].fill_betweenx(df_synth[depth_col], df_orig[res_name], df_synth[res_name], 
                                    where=(df_synth[res_name] >= df_orig[res_name]),
                                    color='gold', alpha=0.5, label='Продуктивная зона (Нефть/Газ)')
            axes[1].set_title("СИНТЕТИКА", fontsize=11, fontweight='bold', color=text_color)
            axes[1].set_xlabel("Уд. Сопротивление (Ом·м)", fontsize=9, fontweight='bold', color=text_color)
            axes[1].legend(fontsize=8, loc='upper right')
            
    elif mode == "Микрозонды (МКЗ)":
        fig, axes = plt.subplots(1, 2, figsize=(plot_width, plot_height), sharey=True)
        c_name = curves_map.get('GMZ')
        if c_name and c_name in df_synth.columns and c_name in df_orig.columns:
            axes[0].semilogx(df_orig[c_name], df_orig[depth_col], color=text_color, lw=1.5, label='Исходное (Вода)')
            axes[0].set_title("ИСХОДНЫЕ ДАННЫЕ", fontsize=11, fontweight='bold', color=text_color)
            axes[0].set_xlabel("Уд. Сопротивление (Ом·м)", fontsize=9, fontweight='bold', color=text_color)
            axes[0].legend(fontsize=8, loc='upper right')
            
            axes[1].semilogx(df_orig[c_name], df_orig[depth_col], color=text_color, lw=1, alpha=0.6, label='Исходное (Ref)')
            axes[1].semilogx(df_synth[c_name], df_synth[depth_col], color='#EF4444', lw=1.8, label='Синтетика (Результат)')
            if apply_fluid_effect and saturation != "Вода (База)":
                axes[1].fill_betweenx(df_synth[depth_col], df_orig[c_name], df_synth[c_name], 
                                    where=(df_synth[c_name] >= df_orig[c_name]),
                                    color='gold', alpha=0.5, label='Продуктивная зона (Нефть/Газ)')
            axes[1].set_title("СИНТЕТИКА", fontsize=11, fontweight='bold', color=text_color)
            axes[1].set_xlabel("Уд. Сопротивление (Ом·м)", fontsize=9, fontweight='bold', color=text_color)
            axes[1].legend(fontsize=8, loc='upper right')
            
    elif mode == "Проводимость (ИК)":
        fig, axes = plt.subplots(1, 2, figsize=(plot_width, plot_height), sharey=True)
        c_name = curves_map.get('COND')
        color = '#F59E0B'
        if c_name and c_name in df_synth.columns and c_name in df_orig.columns:
            axes[0].semilogx(df_orig[c_name], df_orig[depth_col], color=text_color, lw=1.5, label='Исходное (Вода)')
            axes[0].set_title("ИСХОДНЫЕ ДАННЫЕ", fontsize=11, fontweight='bold', color=text_color)
            axes[0].set_xlabel("Проводимость (мСм/м)", fontsize=9, fontweight='bold', color=text_color)
            axes[0].legend(fontsize=8, loc='upper right')
            
            axes[1].semilogx(df_orig[c_name], df_orig[depth_col], color=text_color, lw=1, alpha=0.6, label='Исходное (Ref)')
            axes[1].semilogx(df_synth[c_name], df_synth[depth_col], color=color, lw=1.8, label='Синтетика (Результат)')
            if apply_fluid_effect and saturation != "Вода (База)":
                axes[1].fill_betweenx(df_synth[depth_col], df_orig[c_name], df_synth[c_name], 
                                    where=(df_synth[c_name] <= df_orig[c_name]),
                                    color='gold', alpha=0.5, label='Падение проводимости (Нефть/Газ)')
            axes[1].set_title("СИНТЕТИКА", fontsize=11, fontweight='bold', color=text_color)
            axes[1].set_xlabel("Проводимость (мСм/м)", fontsize=9, fontweight='bold', color=text_color)
            axes[1].legend(fontsize=8, loc='upper right')
            
    elif mode == "Нейтронная пористость (НКТ)":
        fig, axes = plt.subplots(1, 2, figsize=(plot_width, plot_height), sharey=True)
        c_name = curves_map.get('NPHI')
        color = '#10B981'
        for i, (df, label) in enumerate([(df_orig, 'ИСХОДНЫЕ ДАННЫЕ'), (df_synth, 'СИНТЕТИКА (РЕЗУЛЬТАТ)')]):
            if c_name and c_name in df.columns:
                axes[i].plot(df[c_name], df[depth_col], color=color, lw=1.5)
                axes[i].fill_betweenx(df[depth_col], df[c_name].min(), df[c_name], color=color, alpha=0.15)
            axes[i].set_title(f"{label}", fontsize=11, fontweight='bold', color=text_color)
            axes[i].set_xlabel("НКТ (д.е.)", fontsize=9, fontweight='bold', color=text_color)

    for ax in axes:
        ax.invert_yaxis()
        if show_grid:
            ax.grid(True, alpha=0.2, linestyle='--')
        else:
            ax.grid(False)
        ax.tick_params(labelsize=9, colors=text_color)
        ax.set_facecolor(ax_bg)
        for spine in ax.spines.values():
            spine.set_color(spine_color)
    
    axes[0].set_ylabel("ГЛУБИНА (М)", fontsize=10, fontweight='bold', color=text_color)
    fig.patch.set_facecolor(fig_bg)
    plt.subplots_adjust(wspace=0.12)
    return fig

def plot_distribution_comparison(df_orig, df_synth, c_name):
    plt.style.use('dark_background')
    fig_bg = '#1F262F'
    ax_bg = '#161B22'
    text_color = '#94A3B8'
    spine_color = '#2D333B'
        
    fig, ax = plt.subplots(figsize=(6, 3))
    orig_data = df_orig[c_name].dropna()
    synth_data = df_synth[c_name].dropna()
    
    is_log = c_name in ['RES', 'COND', 'BK', 'IK', 'GMZ', 'PMZ']
    if is_log:
        orig_data = np.log10(orig_data[orig_data > 0])
        synth_data = np.log10(synth_data[synth_data > 0])
        ax.set_xlabel("Log10(Амплитуда)", fontsize=8, color=text_color)
    else:
        ax.set_xlabel("Амплитуда", fontsize=8, color=text_color)

    ax.hist(orig_data, bins=40, alpha=0.5, color=text_color, label='Исходник', density=True)
    ax.hist(synth_data, bins=40, alpha=0.5, color='#EF4444', label='Синтетика', density=True)
    
    ax.set_ylabel("Плотность", fontsize=8, color=text_color)
    ax.tick_params(labelsize=8, colors=text_color)
    ax.legend(fontsize=8, loc='upper right')
    ax.set_facecolor(ax_bg)
    fig.patch.set_facecolor(fig_bg)
    for spine in ax.spines.values():
        spine.set_color(spine_color)
    
    plt.tight_layout()
    return fig

# --- КОНФИГУРАЦИЯ СТРАНИЦЫ ---
st.set_page_config(
    page_title="GeoSynth Professional",
    page_icon="🧬",
    layout="wide",
    initial_sidebar_state="expanded",
)

# --- БЛОК НАСТРОЕК ВНЕШНЕГО ВИДА ---
st.sidebar.markdown("#### 🎨 Внешний вид")
with st.sidebar.expander("Масштаб графиков", expanded=False):
    plot_width = st.slider("Ширина графика", min_value=6, max_value=20, value=10, step=1)
    plot_height = st.slider("Высота графика", min_value=4, max_value=20, value=8, step=1)
    show_grid = st.checkbox("Показывать сетку", value=True)
    app_mode = st.sidebar.radio("Режим работы GeoSynth:", 
                            ["Генерация клонов (1 скважина)", "Морфинг фаций (2 скважины)", "Пространственная интерполяция (IDW)"])

